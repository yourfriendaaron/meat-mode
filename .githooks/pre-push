#!/usr/bin/env bash
# Block pushes that would publish the private beads issues: any ref other
# than a branch or tag (Dolt keeps its data in refs/dolt/), Dolt's own
# __dolt branches, and commits whose .beads/ holds data or names a Dolt
# remote. bd can commit its config on its own, past the pre-commit hook,
# and a later commit may remove what it added again, so the commits being
# pushed are checked too, not only the tip. The messages of those commits,
# their author and committer lines, the ref names, and an annotated tag's
# own message and tagger (a tag may point at another tag) go through the
# public-safety guard.
set -euo pipefail
guard="$(cd "$(dirname "$0")/.." && pwd)/scripts/public-safety.sh"
msgs=$(mktemp)
trap 'rm -f "$msgs"' EXIT
zero=0000000000000000000000000000000000000000
beads_ok='\.beads/(\.gitignore|README\.md|config\.yaml|metadata\.json)'
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/__dolt*) echo "pre-push: refusing $remote_ref; beads data stays private (see AGENTS.md)." >&2; status=1; continue ;;
    refs/heads/*|refs/tags/*) ;;
    *) echo "pre-push: refusing $remote_ref; only branches and tags are pushed (see AGENTS.md)." >&2; status=1; continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue
  git cat-file -e "$local_sha^{tree}" 2>/dev/null || continue
  extra=$(git ls-tree -r --name-only "$local_sha" -- .beads | grep -v -x -E "$beads_ok" || true)
  if [ -n "$extra" ]; then
    printf 'pre-push: %s tracks beads data:\n%s\n' "$remote_ref" "$extra" >&2
    status=1
  fi
  if git show "$local_sha:.beads/config.yaml" 2>/dev/null | grep -q -E '^[[:space:]]*(sync\.)?remote:'; then
    echo "pre-push: $remote_ref has a Dolt remote in .beads/config.yaml; drop that commit (bd makes it as \"bd: update sync.remote\")." >&2
    status=1
  fi

  # The commits this push adds: the remote keeps every commit, so one that
  # adds beads data or a Dolt remote is refused even when a later commit
  # removes it again and the tip looks clean.
  revs=("$local_sha" --not)
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    revs+=("$remote_sha")
  else
    revs+=(--remotes)
  fi
  added=$(git log --format= --name-only --diff-filter=AM --no-renames -m "${revs[@]}" -- .beads |
    grep -E '^\.beads/' | grep -v -x -E "$beads_ok" || true)
  if [ -n "$added" ]; then
    printf 'pre-push: %s would push commits that track beads data:\n%s\n' "$remote_ref" "$added" >&2
    status=1
  fi
  # Added lines only: a commit that removes a remote again is welcome.
  config_log=$(git log -p -m --format= "${revs[@]}" -- .beads/config.yaml 2>/dev/null || true)
  remote_line=$(printf '%s\n' "$config_log" | grep -E '^\+[[:space:]]*(sync\.)?remote:' || true)
  if [ -n "$remote_line" ]; then
    echo "pre-push: $remote_ref would push a commit that adds a Dolt remote to .beads/config.yaml (bd makes it as \"bd: update sync.remote\")." >&2
    status=1
  fi

  # The messages of the commits pushed, and their author and committer
  # lines: a name or address is published with a commit as surely as its
  # message.
  git log --format=%B "${revs[@]}" > "$msgs"
  git log --format='%an <%ae>%n%cn <%ce>' "${revs[@]}" >> "$msgs"
  # The ref names themselves, local and remote, which are published too.
  printf '%s\n' "$local_ref" "$remote_ref" >> "$msgs"
  # An annotated tag's own message and its tagger line. A tag may point at
  # another tag, so the chain is followed to the object at its end and
  # every tag on the way is scanned.
  obj=$local_sha
  while [ "$(git cat-file -t "$obj" 2>/dev/null)" = tag ]; do
    git cat-file tag "$obj" >> "$msgs"
    obj=$(git cat-file tag "$obj" | sed -n 's/^object //p')
  done
  if ! "$guard" --message "$msgs" >&2; then
    echo "pre-push: $remote_ref would publish the message text above; reword it (git commit --amend, or git rebase)." >&2
    status=1
  fi
done
exit "$status"
