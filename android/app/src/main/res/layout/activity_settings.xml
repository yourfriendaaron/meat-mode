<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/settings_title" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_hub" />
        <TextView android:id="@+id/hub" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_reminders" />
        <TextView android:id="@+id/reminders" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_reminders_hint"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_distributor" />
        <TextView android:id="@+id/distributor" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_last_push" />
        <TextView android:id="@+id/last_push" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_battery" />
        <TextView android:id="@+id/battery_state" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button
            android:id="@+id/battery"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/battery_allow" />

        <Button
            android:id="@+id/notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_notifications" />

        <Button
            android:id="@+id/push_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_push_log" />

        <Button
            android:id="@+id/change_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_change_hub" />
    </LinearLayout>
</ScrollView>
