# Local configuration and secrets: never tracked
.env
.env.*
!.env.example
mise.local.toml
.envrc
# A deployment's own Compose files (docs/deploy.md copies the example here)
/compose.yaml
/compose.yml
/compose.override.yaml
/compose.override.yml
/docker-compose*.yaml
/docker-compose*.yml
/compose.*.yaml
/compose.*.yml
!/compose.example.yaml
*.local
*.local.*
.public-safety.local

# Data: never tracked
*.db
*.db-*
*.sqlite
*.sqlite3
data/
backups/
*.log

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Beads / Dolt runtime files
.dolt/
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
/.beads/issues.jsonl

# Tooling
*.test
*.out
*.prof
.idea/
.vscode/
node_modules/
dist/
coverage/
test-results/
playwright-report/
.DS_Store

# Built frontend (embedded by web/embed.go)
web/static/*
!web/static/.gitkeep
/meat-mode
/bin/

# Agent harness worktrees and local settings
.claude/
.worktrees/
