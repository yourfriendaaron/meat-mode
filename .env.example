# Every setting Meat Mode reads, with placeholder values. Copy to .env and fill in; .env is never tracked.

# --- Hub ---
# Address the hub listens on inside its container or host.
MEAT_MODE_LISTEN=:8080
# Directory for the SQLite database and VAPID keys. Must be local storage, not NFS or SMB.
MEAT_MODE_DATA_DIR=/data
# The HTTPS address people open the app at (its Tailscale address or your reverse
# proxy's address, see docs/deploy.md); used in reminder links. Required: the hub refuses to start without an https://
# address, except http:// on localhost for development.
MEAT_MODE_PUBLIC_URL=https://meat-mode.example.com
# Other host names the app is opened at, comma-separated. The app always answers to
# localhost, 127.0.0.1 and the MEAT_MODE_PUBLIC_URL host, and refuses any other name.
MEAT_MODE_ALLOWED_HOSTS=meat-mode.example.com
# Login password for the app, as an Argon2id hash. Leave both empty for no login, which
# is safe only when the hub is reachable through Tailscale or another private network.
# Make the hash with `meat-mode hash-password`, or in the image:
#   docker run --rm -it --entrypoint /meat-mode meat-mode hash-password
# The hash contains `$`. In this file used by Compose, wrap it in single quotes; with
# `docker run --env-file`, write it without quotes. See docs/deploy.md.
MEAT_MODE_PASSWORD_HASH=
# Or the path of a file inside the container that holds the hash (a Docker or Compose
# secret, such as /run/secrets/meat_mode_password_hash). Set only one of the two.
MEAT_MODE_PASSWORD_HASH_FILE=
# Name the app writes notes as (notes are authored "<user>-app").
MEAT_MODE_USER=alex
# Contact for Web Push services (mailto: or https: URL).
MEAT_MODE_VAPID_SUBJECT=mailto:alex@example.com
# Optional ntfy notifier. Leave the URL empty to turn it off.
MEAT_MODE_NTFY_URL=
# The topic to publish to. Required when the URL is set: on a shared server
# such as ntfy.sh the topic name works like a password, so pick a long random
# one, or run your own server and use a token.
MEAT_MODE_NTFY_TOPIC=
MEAT_MODE_NTFY_TOKEN=

# --- Bridge (normally set by `meat-mode bridge pair`, in its config file) ---
# Hub address the bridge dials.
MEAT_MODE_HUB_URL=https://meat-mode.example.com
# Allow plain HTTP to a hub that is not on loopback. Off unless you set it to 1.
MEAT_MODE_ALLOW_INSECURE_HTTP=0
# Token for `meat-mode bridge pair <hub url>` when it is given no token argument,
# so the token stays out of shell history. Leave empty otherwise.
MEAT_MODE_BRIDGE_TOKEN=
