# Every setting Meat Mode reads, with placeholder values. Copy to .env and fill in; .env is never tracked.

# --- Hub ---
# Address the hub listens on inside its container or host.
MEAT_MODE_LISTEN=:8080
# Directory for the SQLite database and VAPID keys. Must be local storage, not NFS or SMB.
MEAT_MODE_DATA_DIR=/data
# The HTTPS address people open the app at (its Tailscale address or your reverse
# proxy's address, see docs/deploy.md); used in reminder links. Required: the hub refuses to start without an https://
# address, except http:// on localhost for development.
MEAT_MODE_PUBLIC_URL=https://meat-mode.example.com
# Other host names the app is opened at, comma-separated. The app always answers to
# localhost, 127.0.0.1, [::1] and the MEAT_MODE_PUBLIC_URL host, and refuses any other name.
MEAT_MODE_ALLOWED_HOSTS=meat-mode.example.com
# Login password for the app, as an Argon2id hash, for scripted installs. Leave both empty
# to set the password in the app instead, with the one-time setup code the hub writes to
# its log and to setup-code in the data directory. Until a password is set, the hub
# serves only that setup step. A hash set here wins over the password set in the app.
# Make the hash with `meat-mode hash-password`, or in the image:
#   docker run --rm -it --entrypoint /meat-mode meat-mode hash-password
# The hash contains `$`. In this file used by Compose, wrap it in single quotes; with
# `docker run --env-file`, write it without quotes. See docs/deploy.md.
MEAT_MODE_PASSWORD_HASH=
# Or the path of a file inside the container that holds the hash (a Docker or Compose
# secret, such as /run/secrets/meat_mode_password_hash). Set only one of the two.
MEAT_MODE_PASSWORD_HASH_FILE=
# Name the app writes notes as (notes are authored "<user>-app"). It is the default: a name
# set in the app (the setup wizard or Settings) replaces it.
MEAT_MODE_USER=alex
# Contact for Web Push services (mailto: or https: URL).
MEAT_MODE_VAPID_SUBJECT=mailto:alex@example.com
# Optional ntfy notifier. Leave the URL empty to turn it off.
MEAT_MODE_NTFY_URL=
# The topic to publish to. Required when the URL is set: on a shared server
# such as ntfy.sh the topic name works like a password, so pick a long random
# one, or run your own server and use a token.
MEAT_MODE_NTFY_TOPIC=
MEAT_MODE_NTFY_TOKEN=
# Push servers the Android app may register that are not on the public internet, such as
# your own ntfy on the tailnet or the LAN: host names and CIDRs, comma-separated. Empty
# admits only push servers at global addresses. See docs/api.md, Devices.
MEAT_MODE_PUSH_ALLOW=
# Your own networks that are not in the private set, comma-separated CIDRs, such as your
# LAN's global IPv6 prefix. The hub refuses every request from outside loopback, RFC 1918,
# the RFC 6598 shared range Tailscale uses, unique-local and link-local IPv6, and these.
# Each entry is at most /16 for IPv4 and /48 for IPv6. The bridge reads it too, for the hub
# address it dials. See docs/api.md, Private network only.
MEAT_MODE_TRUSTED_NETWORKS=
# For tests only: how often the hub checks for due reminders, as a Go duration (such as 2s).
# MEAT_MODE_REMINDER_INTERVAL=

# --- Bridge (normally set by `meat-mode bridge pair`, in its config file) ---
# Hub address the bridge dials.
MEAT_MODE_HUB_URL=https://meat-mode.example.com
# Allow plain HTTP to a hub that is not on loopback. Off unless you set it to 1.
MEAT_MODE_ALLOW_INSECURE_HTTP=0
# Token for `meat-mode bridge pair <hub url>` when it is given no token argument,
# so the token stays out of shell history. Leave empty otherwise.
MEAT_MODE_BRIDGE_TOKEN=
# For tests only: one poll interval for every loop the bridge runs, as a Go duration (such as 200ms).
# MEAT_MODE_BRIDGE_POLL=

# --- Agent runs (bridge; see docs/deploy.md, "Wake an agent on a task") ---
# Agents run only in repos switched on at this machine with `meat-mode bridge agents on <repo>`.
# The app can switch them off, not on.
# The harness that runs agents: claude (Claude Code, the default), or another name from
# docs/harnesses.md. The bridge refuses to start with a name it does not know.
MEAT_MODE_AGENT_HARNESS=claude
# The harness's program and fixed flags, split on spaces (no shell); empty for the
# harness's own. The harness still adds the prompt, the session and the cap. Claude Code's:
# claude -p --input-format stream-json --output-format stream-json --verbose --replay-user-messages --permission-mode auto --permission-prompts none
MEAT_MODE_AGENT_COMMAND=
# Name shown for the agent when the task's creator is not an agent.
MEAT_MODE_AGENT_NAME=agent
# Longest one run may take, as a Go duration.
MEAT_MODE_AGENT_TIMEOUT=30m
# Most one run may spend, in US dollars. Ignored by a harness that reports no cost.
MEAT_MODE_AGENT_BUDGET_USD=2
# Runs one task may have in its lifetime.
MEAT_MODE_AGENT_RUNS_PER_TASK=10
# Runs live at once on this machine.
MEAT_MODE_AGENT_CONCURRENT=2
# How long a task's worktree stays after its latest run ended, as a Go duration. The next
# ask makes it again and resumes the conversation.
MEAT_MODE_AGENT_KEEP_WORKTREES=24h
# The four above are this machine's defaults. Settings in the app can change each one, up to
# these ceilings; the bridge refuses anything above them. Unset, a ceiling is the value
# below, or the default above when that is higher.
MEAT_MODE_AGENT_MAX_TIMEOUT=4h
MEAT_MODE_AGENT_MAX_BUDGET_USD=20
MEAT_MODE_AGENT_MAX_RUNS_PER_TASK=50
MEAT_MODE_AGENT_MAX_CONCURRENT=5
